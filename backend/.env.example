# Postgres connection string. You'll build this yourself once you've created
# your local database — see the Postgres setup steps.
# Format: postgresql://<user>:<password>@localhost:5432/<database_name>
DATABASE_URL=postgresql://your_user:your_password@localhost:5432/expense_splitter

# Secret used to sign JWTs. Generate your own long random string —
# never reuse this placeholder. e.g. run: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string

# Port the Express server listens on.
PORT=5000
